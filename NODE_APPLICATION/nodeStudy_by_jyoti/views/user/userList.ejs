<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User List</title>
    <!-- Bootstrap CSS -->
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <!-- Optional: Font Awesome for icons (if needed) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa; /* Light background color for a sober look */
        }
        .container {
            background-color: #ffffff; /* White background for the container */
            padding: 20px;
            border-radius: 8px; /* Rounded corners */
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* Subtle shadow */
        }
        .table th, .table td {
            text-align: center;
        }
        .action-buttons a {
            margin-right: 5px;
        }
        .alert {
            margin-bottom: 20px;
        }
        .btn-primary {
            background-color: #007bff; /* Primary button color */
            border-color: #007bff;
        }
        .btn-warning {
            background-color: #ffc107; /* Warning button color */
            border-color: #ffc107;
        }
        .btn-danger {
            background-color: #dc3545; /* Danger button color */
            border-color: #dc3545;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="text-center mb-3">
            <h3>User List</h3>
        </div>
        <div class="text-center p-3">
            <% if(successMessages.length > 0){ %>
                <div class="alert alert-success" role="alert">
                    <% successMessages.forEach((msg) => { %> <%= msg %> <% }) %>
                </div>
            <% } %>
            <% if(errorMessages.length > 0){ %>
                <div class="alert alert-danger" role="alert">
                    <% errorMessages.forEach((msg) => { %> <%= msg %> <% }) %>
                </div>
            <% } %>
        </div>
        <a href="/user/add-user" class="btn btn-primary mb-3">Add New User</a>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Address</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Zip Code</th>
                        <th>Country</th>
                        <th>Date of Birth</th>
                        <th>Role</th>
                        <th>Is Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(users != null){
                        users.forEach((user) => { %>
                        <tr>
                            <td><%= user.username %></td>
                            <td><%= user.email %></td>
                            <td><%= user.phone_number %></td>
                            <td><%= user.first_name %></td>
                            <td><%= user.last_name %></td>
                            <td><%= user.address %></td>
                            <td><%= user.city %></td>
                            <td><%= user.state %></td>
                            <td><%= user.zip_code %></td>
                            <td><%= user.country %></td>
                            <td><%= moment(user.date_of_birth).format("YYYY-MM-DD") %></td>
                            <td><%= user.role %></td>
                            <td><%= user.is_active ? 'Yes' : 'No' %></td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Basic mixed styles example">
                                    <button type="button" class="btn btn-sm btn-primary" onclick="location.href='/user/add-user/<%= user.user_id %>'"><i class="bi bi-pencil-fill"></i> Edit</button>

                                    <button type="button" class="btn btn-sm btn-danger" onclick="location.href='/user/delete/<%= user.user_id %>'"><i class="bi bi-archive-fill"></i> Delete</button>
                                </div>
                                <!-- <a href="/user/add-user/<%= user.user_id %>" class="btn btn-warning btn-sm">Edit</a>
                                <a href="/user/delete/<%= user.user_id %>" class="btn btn-danger btn-sm">Delete</a> -->
                            </td>
                        </tr>
                    <% })} else { %>
                        <tr>
                            <td colspan="14" class="text-center">No Data Found</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
