<%- include('../layoutUser/header') %>
<body>
    <div class="container mt-3 mb-3">
        <center class="mt-3">
            <h2>User Registration</h2>
        </center>
        <form id="registrationForm" action="<%= data.id ? '/user/add-update-user/data.user_id' : '/user/add-update-user' %>" method="post">
            <div class="form-row">
                <input type="hidden" name="user_id" value="<%= data.user_id ? data.user_id : '' %>" />
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" value="<%= data.username ? data.username : '' %>">
                    <div class="error" id="usernameError"></div>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="<%= data.email ? data.email : '' %>">
                    <div class="error" id="emailError"></div>
                </div>
                <div class="form-group">
                    <label for="phone_number">Phone Number</label>
                    <input type="tel" id="phone_number" name="phone_number" maxlength="10" minlength="10" value="<%= data.phone_number ? data.phone_number : '' %>">
                    
                    <div class="error" id="phoneNumberError"></div>
                </div>
                
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="first_name">First Name</label>
                    <input type="text" id="first_name" name="first_name" value="<%= data.first_name ? data.first_name : '' %>">
                    <div class="error" id="firstNameError"></div>
                </div>
                <div class="form-group">
                    <label for="last_name">Last Name</label>
                    <input type="text" id="last_name" name="last_name" value="<%= data.last_name ? data.last_name : '' %>">
                    <div class="error" id="lastNameError"></div>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" value="<%= data.password ? data.password : '' %>">
                    <div class="error" id="passwordError"></div>
                </div>
            </div>
            <div class="form-row">
                
                <div class="form-group">
                    <label for="address">Address</label>
                    <input type="text" id="address" name="address" value="<%= data.address ? data.address : '' %>">
                    <div class="error" id="addressError"></div>
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="city">City</label>
                    <input type="text" id="city" name="city" value="<%= data.city ? data.city : '' %>">
                    <div class="error" id="cityError"></div>
                </div>
                <div class="form-group">
                    <label for="state">State</label>
                    <input type="text" id="state" name="state" value="<%= data.state ? data.state : '' %>">
                    <div class="error" id="stateError"></div>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="zip_code">Zip Code</label>
                    <input type="text" id="zip_code" name="zip_code" maxlength="6" minlength="6" value="<%= data.zip_code ? data.zip_code : '' %>">
                    <div class="error" id="zipCodeError"></div>
                </div>
                <div class="form-group">
                    <label for="country">Country</label>
                    <input type="text" id="country" name="country" value="<%= data.country ? data.country : '' %>">
                    <div class="error" id="countryError"></div>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="date_of_birth">Date of Birth</label>
                    <input type="date" id="date_of_birth" name="date_of_birth" value="<%= data.date_of_birth ? moment(data.date_of_birth).format('YYYY-MM-DD') : '' %>">
                    <div class="error" id="dobError"></div>
                </div>
                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role" name="role">
                        <option value="">Please Select</option>
                        <option value="user" <%= data.role === 'user' ? 'selected' : '' %>>User</option>
                        <option value="admin" <%= data.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                </div>
                
                
            </div>
            <div class="form-row">
                <label for="is_active_yes">Is Active</label>
                <input type="radio" id="is_active_yes" name="is_active" value="true" <%= data.is_active ? 'checked' : '' %> > Yes
                <input type="radio" id="is_active_no" name="is_active" value="false" <%= !data.is_active ? 'checked' : '' %> > No
            </div>
            
            <br>
            <div class="form-group">
                <button type="submit">Register</button>
            </div>
        </form>
    </div>
</body>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        $('#phone_number,#zip_code').on('input', function() {
            // Remove non-numeric characters except for the decimal point
            var value = $(this).val();
            var numericValue = value.replace(/[^0-9.]/g, '');

            // Ensure only one decimal point
            if ((numericValue.match(/\./g) || []).length > 1) {
                numericValue = numericValue.replace(/\.+$/, '');
            }

            // Set the cleaned value back to the input field
            $(this).val(numericValue);
        });
    });

    document.getElementById('registrationForm').addEventListener('submit', function(event) {

        
        let valid = true;
        
        const username = document.getElementById('username');
        const email = document.getElementById('email');
        const password = document.getElementById('password');
        const firstName = document.getElementById('first_name');
        const lastName = document.getElementById('last_name');
        const phoneNumber = document.getElementById('phone_number');
        const dob = document.getElementById('date_of_birth');
        const address = document.getElementById('address');
        const city = document.getElementById('city');
        const state = document.getElementById('state');
        const zipCode = document.getElementById('zip_code');
        const country = document.getElementById('country');
        const createdAt = document.getElementById('created_at');

        if (username.value === '') {
            valid = false;
            document.getElementById('usernameError').textContent = 'Username is required.';
        }else{
            valid = true;
            document.getElementById('usernameError').textContent = ''; 
        }

        if (email.value === '') {
            valid = false;
            document.getElementById('emailError').textContent = 'Email is required.';
        }else{
            valid = true;
            document.getElementById('emailError').textContent = '';
        }

        if (password.value === '') {
            valid = false;
            document.getElementById('passwordError').textContent = 'Password is required.';
        }else{
            if(password.value !== ''){
                
                let pass= password.value;
               
                if (pass.length > 15) {
                    valid = false;
                    document.getElementById('passwordError').textContent = 'Password is too lengthy.'; 
                }else if (pass.length < 8)  {
                    valid = false;
                    document.getElementById('passwordError').textContent = 'Password is too short.';
                }else{
                    let regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@.#$!%*?&])[A-Za-z\d@.#$!%*?&]{8,15}$/; 
                    if (regex.test(pass)) { 
                        valid = true; 
                        document.getElementById('passwordError').textContent = '';
                    } else{
                        valid = false; 
                        document.getElementById('passwordError').textContent = 'Password should contain one Upper case, ome number and one special case.';
                    }
                }
            }
        }

        if (firstName.value === '') {
            valid = false;
            document.getElementById('firstNameError').textContent = 'First name is required.';
        }else{
            valid = true;
            document.getElementById('firstNameError').textContent = '';
        }

        if (lastName.value === '') {
            valid = false;
            document.getElementById('lastNameError').textContent = 'Last name is required.';
        }else{
            valid = true;
            document.getElementById('lastNameError').textContent = '';
        }

        if (phoneNumber.value === '') {
            valid = false;
            document.getElementById('phoneNumberError').textContent = 'Phone number is required.';
        }else{
            let reg = /^\d+$/;
            if (reg.test(phoneNumber.value)) { 
                valid = true; 
                document.getElementById('phoneNumberError').textContent = '';
            } else{
                valid = false; 
                document.getElementById('phoneNumberError').textContent = 'Phone Number should be number';
            }
        }

        if (dob.value === '') {
            valid = false;
            document.getElementById('dobError').textContent = 'Date of birth is required.';
        }else{
            valid = true;
            document.getElementById('dobError').textContent = '';
        }

        if (address.value === '') {
            valid = false;
            document.getElementById('addressError').textContent = 'Address is required.';
        }else{
            valid = true;
            document.getElementById('addressError').textContent = '';
        }

        if (city.value === '') {
            valid = false;
            document.getElementById('cityError').textContent = 'City is required.';
        }else{
            valid = true;
            document.getElementById('cityError').textContent = '';
        }

        if (state.value === '') {
            valid = false;
            document.getElementById('stateError').textContent = 'State is required.';
        }else{
            valid = true;
            document.getElementById('stateError').textContent = '';
        }

        if (zipCode.value === '') {
            valid = false;
            document.getElementById('zipCodeError').textContent = 'Zip code is required.';
        }else{
            let reg = /^\d+$/;
            if (reg.test(phoneNumber.value)) { 
                valid = true; 
                document.getElementById('zipCodeError').textContent = '';
            } else{
                valid = false; 
                document.getElementById('zipCodeError').textContent = 'Zip code should be number';
            }
        }

        if (country.value === '') {
            valid = false;
            document.getElementById('countryError').textContent = 'Country is required.';
        }else{
            valid = true;
            document.getElementById('countryError').textContent = '';
        }

        
        if (!valid) {
            event.preventDefault();
        }
    });
</script>

   
