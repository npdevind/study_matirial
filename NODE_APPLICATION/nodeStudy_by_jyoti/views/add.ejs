<%- include('./layout/header') %>
<body>
    <center class="mt-3">
        <a href="/admin/product">
            <button class="btn btn-sm btn-outline-primary border-0"><i class="bi bi-arrow-left-circle-fill"></i></button>
        </a>
    </center>
    <center class="mb-3"><h2>Add New Product</h2></center>

    <div class="p-2">
        <div class="card">
            <form action="<%= data.id ? '/admin/update-product' : '/admin/add-new-product' %>" method="POST" enctype="multipart/form-data">
                <div class="card-body">
                    <div class="row p-4">
                        <input type="hidden" name="edit_id" value="<%= data.id ? data.id : '' %>" />
                        <div class="col-md-6">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" name="name" id="name" value="<%= data.name ? data.name : '' %>" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label for="description" class="form-label">Description</label>
                            <textarea name="description" id="description" class="form-control"><%= data.description ? data.description : '' %></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="price" class="form-label">Price</label>
                            <input type="text" name="price" id="price" value="<%= data.price ? data.price : '' %>" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label for="quantity" class="form-label">Quantity</label>
                            <input type="text" name="quantity" id="quantity" value="<%= data.quantity ? data.quantity : '' %>" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label for="date" class="form-label">Date</label>
                            <input type="date" name="date" id="date" value="<%= data.created_at ? moment(data.created_at).format('YYYY-MM-DD') : '' %>" class="form-control" />
                        </div>
                        <div class="col-md-6 mt-4">
                            <label for="image" class="form-label">Upload Image</label>
                            <input type="file" name="image" id="image"/>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex">
                        <button type="submit" class="btn btn-info btn-sm"><%= data.id ? 'Update' : 'Submit' %></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>

<%- include('./layout/footer') %>
